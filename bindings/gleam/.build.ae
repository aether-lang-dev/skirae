import build
import build (dep)
import binding_build
import gleam
import std.map
import std.os
import std.path

main() {
    b = build.start()
    dep(b, "aether/.build.ae")
    dep(b, "generators/gleam/.build.ae")

    project = binding_build.prepare_project(b, "gleam")
    if project == "" { return 1 }
    gleam_toml = "name = \"skir_bindings_smoke\"\nversion = \"0.1.0\"\ntarget = \"erlang\"\n\n[dependencies]\n"
    if binding_build.write_text(b, path.join(project, "gleam.toml"), gleam_toml) != 0 { return 1 }
    src_dir = path.join(project, "src")
    if binding_build.write_text(b, path.join(src_dir, ".keep"), "") != 0 { return 1 }
    _copy = os.system("cp '${project}/schema.gleam' '${src_dir}/schema.gleam'")

    _src = map.put(b, "source_dir", project)
    rc = gleam.deps(b)
    if rc != 0 { return rc }
    return gleam.build(b)
}
