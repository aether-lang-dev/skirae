import build
import build (dep)
import aether

main() {
    b = build.start()
    dep(b, "generators/typescript/.build.ae")
    dep(b, "generators/python/.build.ae")
    dep(b, "generators/cpp/.build.ae")
    dep(b, "generators/java/.build.ae")
    dep(b, "generators/csharp/.build.ae")
    dep(b, "generators/kotlin/.build.ae")
    dep(b, "generators/rust/.build.ae")
    dep(b, "generators/go/.build.ae")
    dep(b, "generators/dart/.build.ae")
    dep(b, "generators/swift/.build.ae")
    dep(b, "generators/gleam/.build.ae")
    dep(b, "generators/zig/.build.ae")
    dep(b, "generators/moonbit/.build.ae")
    aether.program(b) {
        source("aether/skir.ae")
        output("skir")
    }
}
