import std.fs
import std.json
import std.list
import std.os
import std.string

const JSON_NULL = 0
const JSON_BOOL = 1
const JSON_NUMBER = 2
const JSON_STRING = 3
const JSON_ARRAY = 4
const JSON_OBJECT = 5

fail(msg: string) {
    println(msg)
    exit(1)
}

escape(s: string) -> string {
    out = ""
    i = 0
    n = string.length(s)
    while i < n {
        ch = string.char_at(s, i)
        if ch == 34 {
            out = string.concat(out, "\\\"")
        } else if ch == 92 {
            out = string.concat(out, "\\\\")
        } else if ch == 10 {
            out = string.concat(out, "\\n")
        } else if ch == 13 {
            out = string.concat(out, "\\r")
        } else if ch == 9 {
            out = string.concat(out, "\\t")
        } else {
            out = string.concat(out, string.from_char(ch))
        }
        i = i + 1
    }
    return out
}

quote(s: string) -> string {
    out = "\""
    out = string.concat(out, escape(s))
    out = string.concat(out, "\"")
    return out
}

append(out: string, line: string) -> string {
    out = string.concat(out, line)
    out = string.concat(out, "\n")
    return out
}

json_member(obj: ptr, key: string) -> ptr! {
    v = json.object_get(obj, key)!
    if v == null {
        return null, string.concat("missing key: ", key)
    }
    return v
}

json_string_member(obj: ptr, key: string) -> string! {
    v = json_member(obj, key)!
    s = json.get_string(v)!
    return s
}

json_string_value(value: ptr) -> string! {
    s = json.get_string(value)!
    return s
}

json_array_item(items: ptr, index: int) -> ptr! {
    item = json.array_get(items, index)!
    return item
}

must_string(obj: ptr, key: string) -> string {
    value = json_string_member(obj, key) or {
        fail(err)
        return ""
    }
    return value
}

must_ptr(obj: ptr, key: string) -> ptr {
    value = json_member(obj, key) or {
        fail(err)
        return null
    }
    return value
}

must_array_item(items: ptr, index: int) -> ptr {
    value = json_array_item(items, index) or {
        fail(err)
        return null
    }
    return value
}

must_value_string(value: ptr) -> string {
    text = json_string_value(value) or {
        fail(err)
        return ""
    }
    return text
}

base_name(path: string) -> string {
    return path_basename(path)
}

trim_suffix(s: string, suffix: string) -> string {
    if string.ends_with(s, suffix) != 1 {
        return s
    }
    return string.substring(s, 0, string.length(s) - string.length(suffix))
}

module_stem(path: string) -> string {
    return trim_suffix(base_name(path), ".ae")
}

kind_of(value: ptr) -> string {
    kind = json_string_member(value, "kind") or {
        fail(err)
        return ""
    }
    return kind
}

render_ts_type(ty: ptr) -> string {
    kind = kind_of(ty)
    if kind == "primitive" {
        name = must_string(ty, "name")
        if name == "string" { return "string" }
        if name == "bool" { return "boolean" }
        if name == "float32" { return "number" }
        if name == "int32" { return "number" }
        return "unknown"
    }
    if kind == "array" {
        elem = must_ptr(ty, "element")
        out = render_ts_type(elem)
        out = string.concat(out, "[]")
        return out
    }
    if kind == "optional" {
        inner = must_ptr(ty, "inner")
        out = render_ts_type(inner)
        out = string.concat(out, " | null")
        return out
    }
    if kind == "keyed_array" {
        elem2 = must_ptr(ty, "element")
        out = "Record<string, "
        out = string.concat(out, render_ts_type(elem2))
        out = string.concat(out, ">")
        return out
    }
    if kind == "ref" {
        return must_string(ty, "name")
    }
    return "unknown"
}

render_py_type(ty: ptr) -> string {
    kind = kind_of(ty)
    if kind == "primitive" {
        name = must_string(ty, "name")
        if name == "string" { return "str" }
        if name == "bool" { return "bool" }
        if name == "float32" { return "float" }
        if name == "int32" { return "int" }
        return "object"
    }
    if kind == "array" {
        elem = must_ptr(ty, "element")
        out = "list["
        out = string.concat(out, render_py_type(elem))
        out = string.concat(out, "]")
        return out
    }
    if kind == "optional" {
        inner = must_ptr(ty, "inner")
        out = render_py_type(inner)
        out = string.concat(out, " | None")
        return out
    }
    if kind == "keyed_array" {
        elem2 = must_ptr(ty, "element")
        out = "dict[str, "
        out = string.concat(out, render_py_type(elem2))
        out = string.concat(out, "]")
        return out
    }
    if kind == "ref" {
        return must_string(ty, "name")
    }
    return "object"
}

render_lang_type(lang: string, ty: ptr) -> string {
    if lang == "typescript" { return render_ts_type(ty) }
    if lang == "python" { return render_py_type(ty) }

    kind = kind_of(ty)
    if kind == "primitive" {
        name = must_string(ty, "name")
        if lang == "cpp" {
            if name == "string" { return "std::string" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "float" }
            if name == "int32" { return "std::int32_t" }
        }
        if lang == "java" {
            if name == "string" { return "String" }
            if name == "bool" { return "boolean" }
            if name == "float32" { return "float" }
            if name == "int32" { return "int" }
        }
        if lang == "csharp" {
            if name == "string" { return "string" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "float" }
            if name == "int32" { return "int" }
        }
        if lang == "kotlin" {
            if name == "string" { return "String" }
            if name == "bool" { return "Boolean" }
            if name == "float32" { return "Float" }
            if name == "int32" { return "Int" }
        }
        if lang == "rust" {
            if name == "string" { return "String" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "f32" }
            if name == "int32" { return "i32" }
        }
        if lang == "go" {
            if name == "string" { return "string" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "float32" }
            if name == "int32" { return "int32" }
        }
        if lang == "dart" {
            if name == "string" { return "String" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "double" }
            if name == "int32" { return "int" }
        }
        if lang == "swift" {
            if name == "string" { return "String" }
            if name == "bool" { return "Bool" }
            if name == "float32" { return "Float" }
            if name == "int32" { return "Int32" }
        }
        if lang == "gleam" {
            if name == "string" { return "String" }
            if name == "bool" { return "Bool" }
            if name == "float32" { return "Float" }
            if name == "int32" { return "Int" }
        }
        if lang == "zig" {
            if name == "string" { return "[]const u8" }
            if name == "bool" { return "bool" }
            if name == "float32" { return "f32" }
            if name == "int32" { return "i32" }
        }
        if lang == "moonbit" {
            if name == "string" { return "String" }
            if name == "bool" { return "Bool" }
            if name == "float32" { return "Double" }
            if name == "int32" { return "Int" }
        }
        return "object"
    }
    if kind == "array" {
        elem = must_ptr(ty, "element")
        inner = render_lang_type(lang, elem)
        if lang == "cpp" { return string.concat(string.concat("std::vector<", inner), ">") }
        if lang == "java" { return string.concat(string.concat("java.util.List<", inner), ">") }
        if lang == "csharp" { return string.concat(string.concat("IReadOnlyList<", inner), ">") }
        if lang == "kotlin" { return string.concat(string.concat("List<", inner), ">") }
        if lang == "rust" { return string.concat(string.concat("Vec<", inner), ">") }
        if lang == "go" { return string.concat("[]", inner) }
        if lang == "dart" { return string.concat(string.concat("List<", inner), ">") }
        if lang == "swift" { return string.concat(string.concat("[", inner), "]") }
        if lang == "gleam" { return string.concat(string.concat("List(", inner), ")") }
        if lang == "zig" { return string.concat("[]", inner) }
        if lang == "moonbit" { return string.concat(string.concat("Array[", inner), "]") }
        return inner
    }
    if kind == "optional" {
        inner2 = render_lang_type(lang, must_ptr(ty, "inner"))
        if lang == "cpp" { return string.concat(string.concat("std::optional<", inner2), ">") }
        if lang == "java" { return string.concat(string.concat("java.util.Optional<", inner2), ">") }
        if lang == "csharp" { return string.concat(inner2, "?") }
        if lang == "kotlin" { return string.concat(inner2, "?") }
        if lang == "rust" { return string.concat(string.concat("Option<", inner2), ">") }
        if lang == "go" { return string.concat("*", inner2) }
        if lang == "dart" { return string.concat(inner2, "?") }
        if lang == "swift" { return string.concat(inner2, "?") }
        if lang == "gleam" { return string.concat(string.concat("Option(", inner2), ")") }
        if lang == "zig" { return string.concat("?", inner2) }
        if lang == "moonbit" { return string.concat(inner2, "?") }
        return inner2
    }
    if kind == "keyed_array" {
        elem2 = render_lang_type(lang, must_ptr(ty, "element"))
        if lang == "cpp" { return string.concat(string.concat("std::map<std::string, ", elem2), ">") }
        if lang == "java" { return string.concat(string.concat("java.util.Map<String, ", elem2), ">") }
        if lang == "csharp" { return string.concat(string.concat("IReadOnlyDictionary<string, ", elem2), ">") }
        if lang == "kotlin" { return string.concat(string.concat("Map<String, ", elem2), ">") }
        if lang == "rust" { return string.concat(string.concat("std::collections::BTreeMap<String, ", elem2), ">") }
        if lang == "go" { return string.concat(string.concat("map[string]", elem2), "") }
        if lang == "dart" { return string.concat(string.concat("Map<String, ", elem2), ">") }
        if lang == "swift" { return string.concat(string.concat("[String: ", elem2), "]") }
        if lang == "gleam" { return string.concat(string.concat("Dict(String, ", elem2), ")") }
        if lang == "zig" { return string.concat(string.concat("std.StringHashMap(", elem2), ")") }
        if lang == "moonbit" { return string.concat(string.concat("Map[String, ", elem2), "]") }
        return elem2
    }
    if kind == "ref" {
        return must_string(ty, "name")
    }
    return "object"
}

lower_name(name: string) -> string {
    return string.to_lower(name)
}

render_ts_literal(value: ptr) -> string {
    t = json.type(value)
    if t == JSON_NULL { return "null" }
    if t == JSON_BOOL {
        if json.get_bool(value) == 1 { return "true" }
        return "false"
    }
    if t == JSON_NUMBER {
        return string.from_float(json.get_number(value))
    }
    if t == JSON_STRING {
        s = must_value_string(value)
        return quote(s)
    }
    if t == JSON_ARRAY {
        out = "["
        n = json.array_size(value)
        i = 0
        while i < n {
            item = must_array_item(value, i)
            if i > 0 { out = string.concat(out, ", ") }
            out = string.concat(out, render_ts_literal(item))
            i = i + 1
        }
        out = string.concat(out, "]")
        return out
    }
    if t == JSON_OBJECT {
        out = "{"
        n = json.object_size(value)
        i = 0
        while i < n {
            key, item, err = json.object_entry(value, i)
            if err != "" { fail(err) }
            if i > 0 { out = string.concat(out, ", ") }
            out = string.concat(out, quote(key))
            out = string.concat(out, ": ")
            out = string.concat(out, render_ts_literal(item))
            i = i + 1
        }
        out = string.concat(out, "}")
        return out
    }
    return "null"
}

render_py_literal(value: ptr) -> string {
    t = json.type(value)
    if t == JSON_NULL { return "None" }
    if t == JSON_BOOL {
        if json.get_bool(value) == 1 { return "True" }
        return "False"
    }
    if t == JSON_NUMBER {
        return string.from_float(json.get_number(value))
    }
    if t == JSON_STRING {
        s = must_value_string(value)
        return quote(s)
    }
    if t == JSON_ARRAY {
        out = "["
        n = json.array_size(value)
        i = 0
        while i < n {
            item = must_array_item(value, i)
            if i > 0 { out = string.concat(out, ", ") }
            out = string.concat(out, render_py_literal(item))
            i = i + 1
        }
        out = string.concat(out, "]")
        return out
    }
    if t == JSON_OBJECT {
        out = "{"
        n = json.object_size(value)
        i = 0
        while i < n {
            key, item, err = json.object_entry(value, i)
            if err != "" { fail(err) }
            if i > 0 { out = string.concat(out, ", ") }
            out = string.concat(out, quote(key))
            out = string.concat(out, ": ")
            out = string.concat(out, render_py_literal(item))
            i = i + 1
        }
        out = string.concat(out, "}")
        return out
    }
    return "None"
}

member_name(enum_name: string, name: string) -> string {
    out = enum_name
    out = string.concat(out, name)
    return out
}

render_ts_struct(name: string, fields: ptr) -> string {
    out = "export interface "
    out = string.concat(out, name)
    out = string.concat(out, " {\n")
    n = json.array_size(fields)
    i = 0
    while i < n {
        field = must_array_item(fields, i)
        fname = must_string(field, "name")
        ftype = must_ptr(field, "type")
        line = "  "
        line = string.concat(line, fname)
        line = string.concat(line, ": ")
        line = string.concat(line, render_ts_type(ftype))
        line = string.concat(line, ";\n")
        out = string.concat(out, line)
        i = i + 1
    }
    out = string.concat(out, "}\n")
    return out
}

render_py_struct(name: string, fields: ptr) -> string {
    out = "@dataclass\n"
    out = string.concat(out, "class ")
    out = string.concat(out, name)
    out = string.concat(out, ":\n")
    n = json.array_size(fields)
    if n == 0 {
        out = string.concat(out, "    pass\n")
        return out
    }
    i = 0
    while i < n {
        field = must_array_item(fields, i)
        fname = must_string(field, "name")
        ftype = must_ptr(field, "type")
        line = "    "
        line = string.concat(line, fname)
        line = string.concat(line, ": ")
        line = string.concat(line, render_py_type(ftype))
        line = string.concat(line, "\n")
        out = string.concat(out, line)
        i = i + 1
    }
    return out
}

render_ts_enum(enum_name: string, members: ptr) -> string {
    n = json.array_size(members)
    has_fields = 0
    i = 0
    while i < n {
        m = must_array_item(members, i)
        if kind_of(m) == "field" {
            has_fields = 1
        }
        i = i + 1
    }

    out = ""
    i = 0
    first = 1
    if has_fields == 0 {
        out = "export type "
        out = string.concat(out, enum_name)
        out = string.concat(out, " = ")
        while i < n {
            m2 = must_array_item(members, i)
            if first == 0 { out = string.concat(out, " | ") }
            if kind_of(m2) == "variant" {
                out = string.concat(out, quote(must_string(m2, "name")))
            } else {
                out = string.concat(out, quote(must_string(m2, "name")))
            }
            first = 0
            i = i + 1
        }
        out = string.concat(out, ";\n")
        return out
    }

    i = 0
    while i < n {
        m3 = must_array_item(members, i)
        if kind_of(m3) == "field" {
            child = member_name(enum_name, must_string(m3, "name"))
            out = string.concat(out, "export interface ")
            out = string.concat(out, child)
            out = string.concat(out, " {\n")
            line = "  "
            line = string.concat(line, must_string(m3, "name"))
            line = string.concat(line, ": ")
            line = string.concat(line, render_ts_type(must_ptr(m3, "type")))
            line = string.concat(line, ";\n")
            out = string.concat(out, line)
            out = string.concat(out, "}\n")
        }
        i = i + 1
    }

    out = string.concat(out, "export type ")
    out = string.concat(out, enum_name)
    out = string.concat(out, " = ")
    i = 0
    first = 1
    while i < n {
        m4 = must_array_item(members, i)
        if first == 0 { out = string.concat(out, " | ") }
        if kind_of(m4) == "variant" {
            out = string.concat(out, quote(must_string(m4, "name")))
        } else {
            out = string.concat(out, member_name(enum_name, must_string(m4, "name")))
        }
        first = 0
        i = i + 1
    }
    out = string.concat(out, ";\n")
    return out
}

render_py_enum(enum_name: string, members: ptr) -> string {
    n = json.array_size(members)
    has_fields = 0
    i = 0
    while i < n {
        m = must_array_item(members, i)
        if kind_of(m) == "field" {
            has_fields = 1
        }
        i = i + 1
    }

    out = ""
    if has_fields == 0 {
        out = "class "
        out = string.concat(out, enum_name)
        out = string.concat(out, "(Enum):\n")
        i = 0
        if n == 0 {
            out = string.concat(out, "    pass\n")
            return out
        }
        while i < n {
            m2 = must_array_item(members, i)
            line = "    "
            line = string.concat(line, must_string(m2, "name"))
            line = string.concat(line, " = ")
            line = string.concat(line, quote(must_string(m2, "name")))
            line = string.concat(line, "\n")
            out = string.concat(out, line)
            i = i + 1
        }
        return out
    }

    i = 0
    while i < n {
        m3 = must_array_item(members, i)
        if kind_of(m3) == "field" {
            child = member_name(enum_name, must_string(m3, "name"))
            out = string.concat(out, "@dataclass\nclass ")
            out = string.concat(out, child)
            out = string.concat(out, ":\n")
            line = "    "
            line = string.concat(line, must_string(m3, "name"))
            line = string.concat(line, ": ")
            line = string.concat(line, render_py_type(must_ptr(m3, "type")))
            line = string.concat(line, "\n")
            out = string.concat(out, line)
        }
        i = i + 1
    }

    out = string.concat(out, enum_name)
    out = string.concat(out, " = ")
    first = 1
    i = 0
    while i < n {
        m4 = must_array_item(members, i)
        if first == 0 { out = string.concat(out, " | ") }
        if kind_of(m4) == "variant" {
            out = string.concat(out, "Literal[")
            out = string.concat(out, quote(must_string(m4, "name")))
            out = string.concat(out, "]")
        } else {
            out = string.concat(out, member_name(enum_name, must_string(m4, "name")))
        }
        first = 0
        i = i + 1
    }
    out = string.concat(out, "\n")
    return out
}

render_ts_constant(name: string, value: ptr) -> string {
    out = "export const "
    out = string.concat(out, name)
    out = string.concat(out, " = ")
    out = string.concat(out, render_ts_literal(value))
    out = string.concat(out, ";\n")
    return out
}

render_py_constant(name: string, value: ptr) -> string {
    out = name
    out = string.concat(out, " = ")
    out = string.concat(out, render_py_literal(value))
    out = string.concat(out, "\n")
    return out
}

render_ts_method(name: string, request: ptr, response: ptr) -> string {
    out = "export function "
    out = string.concat(out, name)
    out = string.concat(out, "(request: ")
    out = string.concat(out, render_ts_type(request))
    out = string.concat(out, "): ")
    out = string.concat(out, render_ts_type(response))
    out = string.concat(out, " {\n")
    out = append(out, "  throw new Error(\"Not implemented\")")
    out = string.concat(out, "}\n")
    return out
}

render_py_method(name: string, request: ptr, response: ptr) -> string {
    out = "def "
    out = string.concat(out, name)
    out = string.concat(out, "(request: ")
    out = string.concat(out, render_py_type(request))
    out = string.concat(out, ") -> ")
    out = string.concat(out, render_py_type(response))
    out = string.concat(out, ":\n")
    out = append(out, "    raise NotImplementedError()")
    return out
}

render_ts_module(name: string, decls: ptr) -> string {
    out = "// Generated by skir; do not edit.\n"
    n = json.array_size(decls)
    i = 0
    while i < n {
        decl = must_array_item(decls, i)
        kind = must_string(decl, "kind")
        if kind == "struct" {
            out = string.concat(out, render_ts_struct(must_string(decl, "name"), must_ptr(decl, "fields")))
        } else if kind == "enum" {
            out = string.concat(out, render_ts_enum(must_string(decl, "name"), must_ptr(decl, "members")))
        } else if kind == "constant" {
            value_json = must_ptr(decl, "value")
            out = string.concat(out, render_ts_constant(must_string(decl, "name"), value_json))
        } else if kind == "method" {
            out = string.concat(out, render_ts_method(must_string(decl, "name"), must_ptr(decl, "request"), must_ptr(decl, "response")))
        }
        out = string.concat(out, "\n")
        i = i + 1
    }
    return out
}

render_py_module(name: string, decls: ptr) -> string {
    out = "from __future__ import annotations\n"
    out = string.concat(out, "from dataclasses import dataclass\n")
    out = string.concat(out, "from enum import Enum\n")
    out = string.concat(out, "from typing import Literal\n\n")
    n = json.array_size(decls)
    i = 0
    while i < n {
        decl = must_array_item(decls, i)
        kind = must_string(decl, "kind")
        if kind == "struct" {
            out = string.concat(out, render_py_struct(must_string(decl, "name"), must_ptr(decl, "fields")))
        } else if kind == "enum" {
            out = string.concat(out, render_py_enum(must_string(decl, "name"), must_ptr(decl, "members")))
        } else if kind == "constant" {
            out = string.concat(out, render_py_constant(must_string(decl, "name"), must_ptr(decl, "value")))
        } else if kind == "method" {
            out = string.concat(out, render_py_method(must_string(decl, "name"), must_ptr(decl, "request"), must_ptr(decl, "response")))
        }
        out = string.concat(out, "\n")
        i = i + 1
    }
    return out
}

render_generic_struct(lang: string, name: string, fields: ptr) -> string {
    out = ""
    if lang == "cpp" {
        out = string.concat(out, "struct ")
        out = string.concat(out, name)
        out = string.concat(out, " {\n")
    } else if lang == "java" {
        out = string.concat(string.concat("record ", name), "(\n")
    } else if lang == "csharp" {
        out = string.concat(string.concat("public sealed record ", name), "(\n")
    } else if lang == "kotlin" {
        out = string.concat(string.concat("data class ", name), "(\n")
    } else if lang == "rust" {
        out = string.concat(string.concat("#[derive(Clone, Debug, PartialEq)]\npub struct ", name), " {\n")
    } else if lang == "go" {
        out = string.concat(string.concat("type ", name), " struct {\n")
    } else if lang == "dart" {
        out = string.concat(string.concat("class ", name), " {\n")
    } else if lang == "swift" {
        out = string.concat(string.concat("public struct ", name), " {\n")
    } else if lang == "gleam" {
        out = string.concat(string.concat("pub type ", name), " {\n")
        out = string.concat(out, string.concat(string.concat("  ", name), "(\n"))
    } else if lang == "zig" {
        out = string.concat(string.concat("pub const ", name), " = struct {\n")
    } else if lang == "moonbit" {
        out = string.concat(string.concat("pub(all) struct ", name), " {\n")
    }

    n = json.array_size(fields)
    i = 0
    while i < n {
        field = must_array_item(fields, i)
        fname = must_string(field, "name")
        ftype = render_lang_type(lang, must_ptr(field, "type"))
        if lang == "cpp" {
            out = string.concat(out, "  ")
            out = string.concat(out, ftype)
            out = string.concat(out, " ")
            out = string.concat(out, fname)
            out = string.concat(out, ";\n")
        } else if lang == "java" || lang == "csharp" || lang == "kotlin" || lang == "gleam" {
            out = string.concat(out, "  ")
            if lang == "kotlin" { out = string.concat(out, "val ") }
            if lang == "java" || lang == "csharp" {
                out = string.concat(out, ftype)
                out = string.concat(out, " ")
                out = string.concat(out, fname)
            } else {
                out = string.concat(out, fname)
                out = string.concat(out, ": ")
                out = string.concat(out, ftype)
            }
            if i + 1 < n { out = string.concat(out, ",") }
            out = string.concat(out, "\n")
        } else if lang == "rust" {
            out = string.concat(out, "  pub ")
            out = string.concat(out, fname)
            out = string.concat(out, ": ")
            out = string.concat(out, ftype)
            out = string.concat(out, ",\n")
        } else if lang == "go" {
            out = string.concat(out, "  ")
            out = string.concat(out, fname)
            out = string.concat(out, " ")
            out = string.concat(out, ftype)
            out = string.concat(out, "\n")
        } else if lang == "dart" || lang == "swift" || lang == "zig" || lang == "moonbit" {
            out = string.concat(out, "  ")
            if lang == "dart" {
                out = string.concat(out, "final ")
                out = string.concat(out, ftype)
                out = string.concat(out, " ")
                out = string.concat(out, fname)
                out = string.concat(out, ";")
                out = string.concat(out, "\n")
                i = i + 1
                continue
            }
            if lang == "swift" { out = string.concat(out, "public let ") }
            if lang == "moonbit" { out = string.concat(out, "pub ") }
            out = string.concat(out, fname)
            out = string.concat(out, ": ")
            out = string.concat(out, ftype)
            if lang == "zig" { out = string.concat(out, ",") }
            out = string.concat(out, "\n")
        }
        i = i + 1
    }

    if lang == "java" || lang == "csharp" || lang == "kotlin" {
        out = string.concat(out, ")")
        if lang == "java" || lang == "csharp" { out = string.concat(out, " {}") }
        out = string.concat(out, "\n")
    } else if lang == "cpp" {
        out = string.concat(out, "};\n")
    } else if lang == "dart" {
        out = string.concat(out, "\n  const ")
        out = string.concat(out, name)
        out = string.concat(out, "(")
        j = 0
        while j < n {
            field2 = must_array_item(fields, j)
            if j > 0 { out = string.concat(out, ", ") }
            out = string.concat(out, "this.")
            out = string.concat(out, must_string(field2, "name"))
            j = j + 1
        }
        out = string.concat(out, ");\n}\n")
    } else if lang == "gleam" {
        out = string.concat(out, "  )\n}\n")
    } else if lang == "zig" {
        out = string.concat(out, "};\n")
    } else {
        out = string.concat(out, "}\n")
    }
    return out
}

render_generic_enum(lang: string, enum_name: string, members: ptr) -> string {
    out = ""
    if lang == "cpp" || lang == "csharp" || lang == "java" || lang == "kotlin" || lang == "swift" {
        if lang == "cpp" { out = string.concat(string.concat("enum class ", enum_name), " {\n") }
        if lang == "csharp" { out = string.concat(string.concat("public enum ", enum_name), " {\n") }
        if lang == "java" { out = string.concat(string.concat("public enum ", enum_name), " {\n") }
        if lang == "kotlin" { out = string.concat(string.concat("enum class ", enum_name), " {\n") }
        if lang == "swift" { out = string.concat(string.concat("public enum ", enum_name), " {\n") }
        n = json.array_size(members)
        i = 0
        while i < n {
            m = must_array_item(members, i)
            name = must_string(m, "name")
            out = string.concat(out, "  ")
            if lang == "swift" { out = string.concat(out, "case ") }
            out = string.concat(out, name)
            if i + 1 < n { out = string.concat(out, ",") }
            out = string.concat(out, "\n")
            i = i + 1
        }
        out = string.concat(out, "}\n")
        return out
    }
    if lang == "rust" {
        out = string.concat(string.concat("#[derive(Clone, Debug, PartialEq)]\npub enum ", enum_name), " {\n")
    } else if lang == "go" {
        out = string.concat(string.concat("type ", enum_name), " string\nconst (\n")
    } else if lang == "dart" {
        out = string.concat(string.concat("enum ", enum_name), " {\n")
    } else if lang == "gleam" {
        out = string.concat(string.concat("pub type ", enum_name), " {\n")
    } else if lang == "zig" {
        out = string.concat(string.concat("pub const ", enum_name), " = enum {\n")
    } else if lang == "moonbit" {
        out = string.concat(string.concat("pub(all) enum ", enum_name), " {\n")
    }
    n2 = json.array_size(members)
    j = 0
    while j < n2 {
        m2 = must_array_item(members, j)
        name2 = must_string(m2, "name")
        out = string.concat(out, "  ")
        if lang == "go" {
            out = string.concat(out, name2)
            out = string.concat(out, " ")
            out = string.concat(out, enum_name)
            out = string.concat(out, " = ")
            out = string.concat(out, quote(name2))
        } else {
            out = string.concat(out, name2)
            if lang == "rust" || lang == "zig" { out = string.concat(out, ",") }
        }
        out = string.concat(out, "\n")
        j = j + 1
    }
    out = string.concat(out, "}\n")
    return out
}

render_generic_constant(lang: string, name: string, value: ptr) -> string {
    lit = render_ts_literal(value)
    if lang == "go" { return string.concat(string.concat("const ", name), string.concat(" = ", string.concat(lit, "\n"))) }
    if lang == "rust" { return string.concat(string.concat("pub const ", name), string.concat(": &str = ", string.concat(quote(lit), ";\n"))) }
    if lang == "zig" { return string.concat(string.concat("pub const ", name), string.concat(" = ", string.concat(lit, ";\n"))) }
    if lang == "moonbit" { return string.concat(string.concat("pub let ", name), string.concat(" = ", string.concat(lit, "\n"))) }
    return string.concat(string.concat("const ", name), string.concat(" = ", string.concat(lit, ";\n")))
}

render_generic_method(lang: string, name: string, request: ptr, response: ptr) -> string {
    req = render_lang_type(lang, request)
    res = render_lang_type(lang, response)
    if lang == "cpp" { return string.concat(string.concat(res, " "), string.concat(string.concat(name, string.concat("(" , string.concat(req, " request);"))), "\n")) }
    if lang == "java" { return string.concat(string.concat("public static ", res), string.concat(string.concat(" ", name), string.concat(string.concat("(" , req), " request) { throw new UnsupportedOperationException(); }\n"))) }
    if lang == "csharp" { return string.concat(string.concat("public static ", res), string.concat(string.concat(" ", name), string.concat(string.concat("(" , req), " request) => throw new NotImplementedException();\n"))) }
    if lang == "kotlin" { return string.concat(string.concat("fun ", name), string.concat(string.concat("(request: ", req), string.concat(string.concat("): ", res), " = TODO()\n"))) }
    if lang == "rust" { return string.concat(string.concat("pub fn ", lower_name(name)), string.concat(string.concat("(request: ", req), string.concat(string.concat(") -> ", res), " { unimplemented!() }\n"))) }
    if lang == "go" { return string.concat(string.concat("func ", name), string.concat(string.concat("(request ", req), string.concat(string.concat(") ", res), " { panic(\"not implemented\") }\n"))) }
    if lang == "dart" { return string.concat(string.concat(res, " "), string.concat(string.concat(name, string.concat("(" , req)), " request) => throw UnimplementedError();\n")) }
    if lang == "swift" { return string.concat(string.concat("public func ", name), string.concat(string.concat("(request: ", req), string.concat(string.concat(") -> ", res), " { fatalError(\"Not implemented\") }\n"))) }
    if lang == "gleam" { return string.concat(string.concat("pub fn ", lower_name(name)), string.concat(string.concat("(request: ", req), string.concat(string.concat(") -> ", res), " { panic as \"not implemented\" }\n"))) }
    if lang == "zig" { return string.concat(string.concat("pub fn ", name), string.concat(string.concat("(request: ", req), string.concat(string.concat(") ", res), " { unreachable; }\n"))) }
    if lang == "moonbit" { return string.concat(string.concat("pub fn ", name), string.concat(string.concat("(request: ", req), string.concat(string.concat(") -> ", res), " { abort(\"not implemented\") }\n"))) }
    return ""
}

render_generic_module(lang: string, decls: ptr) -> string {
    out = "// Generated by skir; do not edit.\n"
    if lang == "cpp" { out = "#pragma once\n#include <cstdint>\n#include <optional>\n#include <string>\n#include <vector>\n#include <map>\n\n" }
    if lang == "java" { out = "package skir.bindings;\n\n" }
    if lang == "csharp" { out = "using System;\nusing System.Collections.Generic;\n\nnamespace Skir.Bindings;\n\n" }
    if lang == "go" { out = "package skirbindings\n\n" }
    if lang == "rust" { out = "// Generated by skir; do not edit.\n\n" }
    if lang == "swift" { out = "import Foundation\n\n" }
    if lang == "zig" { out = "const std = @import(\"std\");\n\n" }
    n = json.array_size(decls)
    i = 0
    while i < n {
        decl = must_array_item(decls, i)
        kind = must_string(decl, "kind")
        if kind == "struct" {
            out = string.concat(out, render_generic_struct(lang, must_string(decl, "name"), must_ptr(decl, "fields")))
        } else if kind == "enum" {
            out = string.concat(out, render_generic_enum(lang, must_string(decl, "name"), must_ptr(decl, "members")))
        } else if kind == "constant" {
            out = string.concat(out, render_generic_constant(lang, must_string(decl, "name"), must_ptr(decl, "value")))
        } else if kind == "method" {
            out = string.concat(out, render_generic_method(lang, must_string(decl, "name"), must_ptr(decl, "request"), must_ptr(decl, "response")))
        }
        out = string.concat(out, "\n")
        i = i + 1
    }
    return out
}

lang_extension(lang: string) -> string {
    if lang == "cpp" { return ".hpp" }
    if lang == "java" { return ".java" }
    if lang == "csharp" { return ".cs" }
    if lang == "kotlin" { return ".kt" }
    if lang == "rust" { return ".rs" }
    if lang == "go" { return ".go" }
    if lang == "dart" { return ".dart" }
    if lang == "swift" { return ".swift" }
    if lang == "gleam" { return ".gleam" }
    if lang == "zig" { return ".zig" }
    if lang == "moonbit" { return ".mbt" }
    return ".txt"
}

lang_from_text(text: string) -> string {
    if string.contains(text, "typescript") == 1 { return "typescript" }
    if string.contains(text, "python") == 1 { return "python" }
    if string.contains(text, "csharp") == 1 { return "csharp" }
    if string.contains(text, "cpp") == 1 { return "cpp" }
    if string.contains(text, "java") == 1 { return "java" }
    if string.contains(text, "kotlin") == 1 { return "kotlin" }
    if string.contains(text, "rust") == 1 { return "rust" }
    if string.contains(text, "go") == 1 { return "go" }
    if string.contains(text, "dart") == 1 { return "dart" }
    if string.contains(text, "swift") == 1 { return "swift" }
    if string.contains(text, "gleam") == 1 { return "gleam" }
    if string.contains(text, "zig") == 1 { return "zig" }
    if string.contains(text, "moonbit") == 1 { return "moonbit" }
    return ""
}

write_generic_outputs(lang: string, out_dir: string, modules: ptr) {
    nmods = json.array_size(modules)
    i = 0
    while i < nmods {
        mod = must_array_item(modules, i)
        path = must_string(mod, "path")
        decls = must_ptr(mod, "declarations")
        stem = module_stem(path)
        ext = lang_extension(lang)
        mod_file = path_join(out_dir, string.concat(stem, ext))
        write_err = fs.write(mod_file, render_generic_module(lang, decls))
        if write_err != "" { fail(write_err) }
        i = i + 1
    }
}

render_ts_root(modules: ptr) -> string {
    out = "// Generated by skir; do not edit.\n"
    n = json.array_size(modules)
    i = 0
    while i < n {
        mod = must_array_item(modules, i)
        path = must_string(mod, "path")
        out = string.concat(out, "export * from \"./")
        out = string.concat(out, module_stem(path))
        out = string.concat(out, "\";\n")
        i = i + 1
    }
    return out
}

render_py_root(modules: ptr) -> string {
    out = "# Generated by skir; do not edit.\n"
    n = json.array_size(modules)
    i = 0
    while i < n {
        mod = must_array_item(modules, i)
        path = must_string(mod, "path")
        out = string.concat(out, "from .")
        out = string.concat(out, module_stem(path))
        out = string.concat(out, " import *\n")
        i = i + 1
    }
    return out
}

render_ts_package() -> string {
    return "{\n  \"name\": \"skir-bindings\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"version\": \"0.0.0\"\n}\n"
}

render_pyproject() -> string {
    return "[build-system]\nrequires = [\"setuptools>=68\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"skir-bindings\"\nversion = \"0.0.0\"\nrequires-python = \">=3.10\"\n"
}

main() {
    argc = aether_args_count()
    if argc < 3 {
        fail("usage: skir-bindgen <ir.json> <out-dir>")
    }

    ir_path = aether_args_get(1)
    out_dir = aether_args_get(2)
    lang = lang_from_text(out_dir)
    if lang == "" && argc >= 4 {
        lang = aether_args_get(3)
    }
    if lang == "" {
        argv0 = os.argv0()
        base = path_basename(argv0)
        lang = lang_from_text(base)
    }
    if lang == "" {
        lang = "typescript"
    }
    text, read_err = fs.read(ir_path)
    if read_err != "" {
        fail(string.concat("cannot read IR: ", read_err))
    }
    root, parse_err = json.parse(text)
    if parse_err != "" || root == null {
        fail(string.concat("cannot parse IR: ", parse_err))
    }

    modules = must_ptr(root, "modules")
    if json.array_size(modules) == 0 {
        fail("IR has no modules")
    }

    mkdir_err = fs.mkdir_p(out_dir)
    if mkdir_err != "" {
        fail(string.concat("cannot create output directory: ", mkdir_err))
    }

    if lang == "typescript" {
        out_file = path_join(out_dir, "index.ts")
        write_err = fs.write(out_file, render_ts_root(modules))
        if write_err != "" { fail(write_err) }

        pkg = path_join(out_dir, "package.json")
        write_err2 = fs.write(pkg, render_ts_package())
        if write_err2 != "" { fail(write_err2) }

        nmods = json.array_size(modules)
        i = 0
        while i < nmods {
            mod = must_array_item(modules, i)
            path = must_string(mod, "path")
            decls = must_ptr(mod, "declarations")
            stem = module_stem(path)
            mod_file = path_join(out_dir, string.concat(stem, ".ts"))
            write_err3 = fs.write(mod_file, render_ts_module(stem, decls))
            if write_err3 != "" { fail(write_err3) }
            i = i + 1
        }
    } else if lang == "python" {
        pkg_dir = path_join(out_dir, "skir")
        mk_err = fs.mkdir_p(pkg_dir)
        if mk_err != "" { fail(mk_err) }
        root_file = path_join(pkg_dir, "__init__.py")
        write_err3 = fs.write(root_file, render_py_root(modules))
        if write_err3 != "" { fail(write_err3) }

        nmods = json.array_size(modules)
        i = 0
        while i < nmods {
            mod = must_array_item(modules, i)
            path = must_string(mod, "path")
            decls = must_ptr(mod, "declarations")
            stem = module_stem(path)
            mod_file = path_join(pkg_dir, string.concat(stem, ".py"))
            write_err4 = fs.write(mod_file, render_py_module(stem, decls))
            if write_err4 != "" { fail(write_err4) }
            i = i + 1
        }

        pyproject = path_join(out_dir, "pyproject.toml")
        write_err5 = fs.write(pyproject, render_pyproject())
        if write_err5 != "" { fail(write_err5) }
    } else {
        write_generic_outputs(lang, out_dir, modules)
    }

    json.free(root)
}
