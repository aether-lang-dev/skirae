import std.fs
import std.collections
import std.list
import std.os
import std.string
import std.json

const VERSION = "2.0.0-aether.0"

help() {
    println("Usage: skir <command> [options]")
    println("")
    println("Commands:")
    println("  init               Create skir.json and skir-src/hello_world.ae")
    println("  gen                Run Aether schema DSL programs and write skirout/skir-ir.json")
    println("  format             Validate schema programs; --ci checks only")
    println("  snapshot           Write skir-snapshot.json; --view displays it")
    println("  version            Print the native Skir version")
    println("  help               Display this help")
    println("")
    println("Options:")
    println("  --root, -r <path>  Project root containing skir.json")
    println("  --watch, -w        Re-run generation when schema sources change")
    println("  --ci               Check mode for format/snapshot")
    println("  --dry-run          Snapshot compatibility mode")
    println("  --view             Display the last snapshot")
}

arg_value(flag: string) -> string {
    n = aether_args_count()
    i = 2
    while i < n {
        a = aether_args_get(i)
        if a == flag {
            if i + 1 < n {
                return aether_args_get(i + 1)
            }
            return ""
        }
        prefix = string.concat(flag, "=")
        if string.starts_with(a, prefix) == 1 {
            return string.substring(a, string.length(prefix), string.length(a))
        }
        i = i + 1
    }
    return ""
}

has_flag(flag: string) -> int {
    n = aether_args_count()
    i = 2
    while i < n {
        if aether_args_get(i) == flag {
            return 1
        }
        i = i + 1
    }
    return 0
}

root_arg() -> string {
    r = arg_value("--root")
    if r != "" {
        return r
    }
    r2 = arg_value("-r")
    if r2 != "" {
        return r2
    }
    return "."
}

run_schema_program(schema_path: string, out_path: string) -> int {
    bin_path = "/tmp/skir_schema_program"
    argv = list.new()
    list.add(argv, "build")
    list.add(argv, schema_path)
    list.add(argv, "--lib")
    list.add(argv, ".")
    list.add(argv, "-o")
    list.add(argv, bin_path)
    build_out, build_code, build_err = os.run_capture("ae", argv, null)
    list.free(argv)
    if build_err != "" {
        println(string.concat("schema build failed to start: ", build_err))
        return 1
    }
    if build_code != 0 {
        println(build_out)
        println(string.concat("schema build failed: ", schema_path))
        return 1
    }
    if fs.exists(bin_path) == 0 {
        println(string.concat("schema binary was not created: ", bin_path))
        return 1
    }
    sleep(100)

    argv2 = list.new()
    list.add(argv2, out_path)
    run_out, run_code, run_err = os.run_capture(bin_path, argv2, null)
    list.free(argv2)
    if run_err != "" {
        println(string.concat("schema program failed to start: ", run_err))
        return 1
    }
    if run_code != 0 {
        println(run_out)
        println(string.concat("schema program exit: ", string.from_int(run_code)))
        println(string.concat("schema program failed: ", schema_path))
        return 1
    }
    return 0
}

collect_schema_sources(src_dir: string) -> (ptr, int) {
    files = string_list_new()
    _, walk_err = fs.walk(src_dir, |path: string, kind: int, depth: int| {
        if kind == 1 && string.ends_with(path, ".ae") == 1 {
            _added = string_list_add(files, path)
        }
        return 0
    })
    if walk_err != "" {
        string_list_free(files)
        return null, 1
    }
    string_list_sort_lex(files)
    return files, 0
}

collect_ir(root: string) -> (string, int) {
    src_dir = path_join(root, "skir-src")
    files, collect_failed = collect_schema_sources(src_dir)
    if collect_failed != 0 || files == null {
        println("No Aether schema programs found in source directory")
        return "{\"schemaVersion\":1,\"implementation\":\"aether-dsl\",\"modules\":[]}", 1
    }
    if string_list_size(files) == 0 {
        string_list_free(files)
        println("No Aether schema programs found in source directory")
        return "{\"schemaVersion\":1,\"implementation\":\"aether-dsl\",\"modules\":[]}", 1
    }
    count = string_list_size(files)
    failed = 0
    out = "{\"schemaVersion\":1,\"implementation\":\"aether-dsl\",\"modules\":["
    first_module = 1
    i = 0
    while i < count {
        full_path = string_list_get(files, i)
        tmp_ir = "/tmp/skir_schema_ir.json"
        rc = run_schema_program(full_path, tmp_ir)
        if rc != 0 {
            failed = 1
        } else {
            ir_text, read_err = fs.read(tmp_ir)
            if read_err != "" {
                println(string.concat("cannot read schema IR: ", tmp_ir))
                failed = 1
            } else {
                parsed, parse_err = json.parse(ir_text)
                if parse_err != "" || parsed == null {
                    println(string.concat("cannot parse schema IR: ", full_path))
                    failed = 1
                } else {
                    modules_v, mod_err = json.object_get(parsed, "modules")
                    if mod_err != "" || modules_v == null {
                        println(string.concat("schema IR missing modules: ", full_path))
                        failed = 1
                    } else {
                        mod_count = json.array_size(modules_v)
                        j = 0
                        while j < mod_count {
                            mod_v, mod_err2 = json.array_get(modules_v, j)
                            if mod_err2 != "" {
                                println(string.concat("schema IR module read failed: ", full_path))
                                failed = 1
                                j = mod_count
                            } else {
                                if first_module == 0 {
                                    out = string.concat(out, ",")
                                }
                                mod_text, stringify_err = json.stringify(mod_v)
                                if stringify_err != "" {
                                    println(string.concat("schema IR stringify failed: ", full_path))
                                    failed = 1
                                } else {
                                    out = string.concat(out, mod_text)
                                    first_module = 0
                                }
                            }
                            j = j + 1
                        }
                        json.free(parsed)
                    }
                }
            }
        }
        i = i + 1
    }
    string_list_free(files)
    out = string.concat(out, "]}")
    return out, failed
}

next_json_string_after(source: string, key: string, start: int) -> (string, int) {
    needle = string.concat("\"", key)
    needle = string.concat(needle, "\"")
    key_pos = string.index_of_from(source, needle, start)
    if key_pos < 0 {
        return "", -1
    }
    colon_pos = string.index_of_from(source, ":", key_pos + string.length(needle))
    if colon_pos < 0 {
        return "", -1
    }
    quote_pos = string.index_of_from(source, "\"", colon_pos + 1)
    if quote_pos < 0 {
        return "", -1
    }
    i = quote_pos + 1
    n = string.length(source)
    while i < n {
        ch = string.char_at(source, i)
        if ch == 92 {
            i = i + 2
        } else if ch == 34 {
            value = string.substring(source, quote_pos + 1, i)
            return value, i + 1
        } else {
            i = i + 1
        }
    }
    return "", -1
}

run_generator_command(command: string, ir_path: string, out_dir: string) -> int {
    argv = list.new()
    list.add(argv, ir_path)
    list.add(argv, out_dir)
    lang = "typescript"
    if string.contains(command, "typescript") == 1 { lang = "typescript" }
    if string.contains(command, "python") == 1 { lang = "python" }
    if string.contains(command, "cpp") == 1 { lang = "cpp" }
    if string.contains(command, "csharp") == 1 { lang = "csharp" }
    if string.contains(command, "java") == 1 { lang = "java" }
    if string.contains(command, "kotlin") == 1 { lang = "kotlin" }
    if string.contains(command, "rust") == 1 { lang = "rust" }
    if string.contains(command, "go") == 1 { lang = "go" }
    if string.contains(command, "dart") == 1 { lang = "dart" }
    if string.contains(command, "swift") == 1 { lang = "swift" }
    if string.contains(command, "gleam") == 1 { lang = "gleam" }
    if string.contains(command, "zig") == 1 { lang = "zig" }
    if string.contains(command, "moonbit") == 1 { lang = "moonbit" }
    list.add(argv, lang)
    stdout, exit_code, spawn_err = os.run_capture(command, argv, null)
    list.free(argv)
    if spawn_err != "" {
        println(string.concat("Generator failed to start: ", spawn_err))
        return 1
    }
    if stdout != "" {
        println(stdout)
    }
    if exit_code != 0 {
        println("Generator exited non-zero")
        return 1
    }
    return 0
}

write_ir_outputs(root: string, ir: string) -> int {
    config_path = path_join(root, "skir.json")
    config, read_err = fs.read(config_path)
    if read_err != "" {
        println(string.concat("Cannot find ", config_path))
        return 1
    }

    wrote = 0
    pos = 0
    while true {
        out_dir_raw, next_pos = next_json_string_after(config, "outDir", pos)
        if next_pos < 0 {
            break
        }
        out_dir = out_dir_raw
        if string.starts_with(out_dir, "./") == 1 {
            out_dir = string.substring(out_dir, 2, string.length(out_dir))
        }
        if out_dir == "" {
            out_dir = "skirout"
        }
        out_path_dir = path_join(root, out_dir)
        err_mkdir = fs.mkdir_p(out_path_dir)
        if err_mkdir != "" {
            println(string.concat("Cannot create ", out_path_dir))
            return 1
        }
        out_path = path_join(out_path_dir, "skir-ir.json")
        err_write = fs.write(out_path, ir)
        if err_write != "" {
            println(string.concat("Cannot write ", out_path))
            return 1
        }
        println(string.concat("Generated ", out_path))

        next_out_dir = string.index_of_from(config, "\"outDir\"", next_pos)
        command_pos = string.index_of_from(config, "\"command\"", pos)
        if command_pos >= 0 && (next_out_dir < 0 || command_pos < next_out_dir) {
            command, _ = next_json_string_after(config, "command", pos)
            if command != "" {
                rc = run_generator_command(command, out_path, out_path_dir)
                if rc != 0 {
                    return rc
                }
            }
        }

        wrote = 1
        pos = next_pos
    }

    if wrote == 0 {
        out_path_dir2 = path_join(root, "skirout")
        err_mkdir2 = fs.mkdir_p(out_path_dir2)
        if err_mkdir2 != "" {
            println(string.concat("Cannot create ", out_path_dir2))
            return 1
        }
        out_path2 = path_join(out_path_dir2, "skir-ir.json")
        err_write2 = fs.write(out_path2, ir)
        if err_write2 != "" {
            println(string.concat("Cannot write ", out_path2))
            return 1
        }
        println(string.concat("Generated ", out_path2))
    }

    return 0
}

run_gen(root: string) -> int {
    ir, failed = collect_ir(root)
    if failed != 0 {
        return 1
    }
    return write_ir_outputs(root, ir)
}

open_schema_watches(src_dir: string) -> ptr {
    dirs = string_list_new()
    _, walk_err = fs.walk(src_dir, |path: string, kind: int, depth: int| {
        if kind == 2 {
            _added = string_list_add(dirs, path)
        }
        return 0
    })
    if walk_err != "" {
        println(string.concat("Cannot watch schema source directory: ", src_dir))
        string_list_free(dirs)
        return null
    }
    string_list_sort_lex(dirs)

    watches = list.new()
    n = string_list_size(dirs)
    i = 0
    while i < n {
        dir_path = string_list_get(dirs, i)
        watch, watch_err = fs.watch_open(dir_path)
        if watch_err != "" {
            println(string.concat("Cannot watch ", dir_path))
            watch_count = list.size(watches)
            j = 0
            while j < watch_count {
                fs.watch_close(list.get_raw(watches, j))
                j = j + 1
            }
            list.free(watches)
            string_list_free(dirs)
            return null
        }
        add_err = list.add(watches, watch)
        if add_err != "" {
            fs.watch_close(watch)
            list.free(watches)
            string_list_free(dirs)
            return null
        }
        i = i + 1
    }
    string_list_free(dirs)
    return watches
}

close_schema_watches(watches: ptr) {
    if watches == null {
        return
    }
    n = list.size(watches)
    i = 0
    while i < n {
        fs.watch_close(list.get_raw(watches, i))
        i = i + 1
    }
    list.free(watches)
}

schema_watches_wait(watches: ptr) -> int {
    if watches == null {
        return -1
    }
    n = list.size(watches)
    if n <= 0 {
        return -1
    }
    i = 0
    while i < n {
        timeout = 0
        if i == 0 {
            timeout = 500
        }
        changed = fs.watch_wait(list.get_raw(watches, i), timeout)
        if changed != 0 {
            return changed
        }
        i = i + 1
    }
    return 0
}

open_config_watch(root: string) -> ptr {
    config_path = path_join(root, "skir.json")
    if fs.exists(config_path) == 0 {
        return null
    }
    watch, watch_err = fs.watch_open(config_path)
    if watch_err != "" {
        return null
    }
    return watch
}

run_gen_watch(root: string) -> int {
    rc = run_gen(root)
    src_dir = path_join(root, "skir-src")
    watches = open_schema_watches(src_dir)
    if watches == null {
        return 1
    }
    config_watch = open_config_watch(root)
    println(string.concat("Watching ", src_dir))

    while true {
        schema_changed = schema_watches_wait(watches)
        if schema_changed < 0 {
            close_schema_watches(watches)
            fs.watch_close(config_watch)
            return 1
        }
        config_changed = 0
        if config_watch != null {
            config_changed = fs.watch_wait(config_watch, 0)
            if config_changed < 0 {
                fs.watch_close(config_watch)
                config_watch = null
                config_changed = 0
            }
        }

        if schema_changed == 1 || config_changed == 1 {
            rc = run_gen(root)
            close_schema_watches(watches)
            watches = open_schema_watches(src_dir)
            if watches == null {
                fs.watch_close(config_watch)
                return 1
            }
            if config_changed == 1 {
                fs.watch_close(config_watch)
                config_watch = open_config_watch(root)
            }
        }
    }
    return rc
}

run_format(root: string) -> int {
    _, failed = collect_ir(root)
    if failed != 0 {
        return 1
    }
    if has_flag("--ci") == 1 {
        println("All schema programs generated IR cleanly.")
    } else {
        println("Native formatter is not rewriting Aether schema programs; generation succeeded.")
    }
    return 0
}

run_snapshot(root: string) -> int {
    path = path_join(root, "skir-snapshot.json")
    if has_flag("--view") == 1 {
        text, err = fs.read(path)
        if err != "" {
            println("No snapshot found.")
            return 0
        }
        println(text)
        return 0
    }
    ir, failed = collect_ir(root)
    if failed != 0 {
        return 1
    }
    if has_flag("--dry-run") == 1 {
        println("Snapshot dry-run succeeded.")
        return 0
    }
    err_write = fs.write(path, ir)
    if err_write != "" {
        println(string.concat("Cannot write ", path))
        return 1
    }
    println(string.concat("Snapshot taken: ", path))
    return 0
}

run_init(root: string) -> int {
    config_path = path_join(root, "skir.json")
    if fs.exists(config_path) == 0 {
        config = "{\n  \"generators\": [\n    { \"kind\": \"ir\", \"outDir\": \"./skirout\" }\n  ],\n  \"dependencies\": {}\n}\n"
        err_config = fs.write(config_path, config)
        if err_config != "" {
            println(string.concat("Cannot write ", config_path))
            return 1
        }
    }
    src_dir = path_join(root, "skir-src")
    err_mkdir = fs.mkdir_p(src_dir)
    if err_mkdir != "" {
        println(string.concat("Cannot create ", src_dir))
        return 1
    }
    hello = path_join(src_dir, "hello_world.ae")
    if fs.exists(hello) == 0 {
        sample = "import skir_schema (document, structure, field, record_name, field_name,\n                    string_type)\nimport std.os\n\nmain() {\n    out = aether_args_get(1)\n    if out == null { out = \"skirout/skir-ir.json\" }\n    document(out) {\n        structure(record_name(\"Greeting\")) {\n            field(field_name(\"message\"), string_type())\n        }\n    }\n}\n"
        err_sample = fs.write(hello, sample)
        if err_sample != "" {
            println(string.concat("Cannot write ", hello))
            return 1
        }
    }
    println(string.concat("Done. Please edit: ", config_path))
    println("To generate code, run: skir gen")
    return 0
}

main() {
    n = aether_args_count()
    if n < 2 {
        help()
        return
    }
    cmd = aether_args_get(1)
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        help()
        return
    }
    if cmd == "version" || cmd == "--version" || cmd == "-v" {
        println(string.concat("v", VERSION))
        return
    }
    root = root_arg()
    rc = 0
    if cmd == "init" {
        rc = run_init(root)
    } else if cmd == "gen" {
        if has_flag("--watch") == 1 || has_flag("-w") == 1 {
            rc = run_gen_watch(root)
        } else {
            rc = run_gen(root)
        }
    } else if cmd == "format" {
        rc = run_format(root)
    } else if cmd == "snapshot" {
        rc = run_snapshot(root)
    } else {
        println(string.concat("Unknown command: ", cmd))
        help()
        rc = 1
    }
    if rc != 0 {
        exit(rc)
    }
}
