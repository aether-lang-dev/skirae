import std.spec
import std.os.testing
import skir_schema (document, structure, enumeration, field, variant,
                    constant, method, string_type, float32_type, array_type,
                    ref_type, record_name, field_name, method_name,
                    method_number)
import std.fs
import std.list
import std.os
import std.string

run_capture1(prog: string, arg: string) -> (string, int, string) {
    argv = list.new()
    list.add(argv, arg)
    out, code, err = os.run_capture(prog, argv, null)
    list.free(argv)
    return out, code, err
}

run_capture2(prog: string, arg1: string, arg2: string) -> (string, int, string) {
    argv = list.new()
    list.add(argv, arg1)
    list.add(argv, arg2)
    out, code, err = os.run_capture(prog, argv, null)
    list.free(argv)
    return out, code, err
}

run_aetherc_effects(source: string, out_c: string) -> (string, int, string) {
    argv = list.new()
    list.add(argv, "--emit=effects")
    list.add(argv, "--lib")
    list.add(argv, string.concat(os.getenv("AEB_HOME"), "/lib"))
    list.add(argv, "--lib")
    list.add(argv, os.getcwd())
    list.add(argv, source)
    list.add(argv, out_c)
    out, code, err = os.run_capture("aetherc", argv, null)
    list.free(argv)
    return out, code, err
}

expect_aeb_target(fw: ptr, target: string) {
    out, code, err = run_capture1("aeb", target)
    testing.expect_no_spawn_error( err, string.concat(target, " build started"))
    testing.expect_exit( code, 0, string.concat(target, " build exits zero"))
}

expect_binding_smoke(fw: ptr, target: string, log_name: string, line: string) {
    expect_aeb_target(fw, target)
    log_path = string.concat("${os.getcwd()}/target/.aeb/logs/", log_name)
    log_text, log_err = fs.read(log_path)
    spec.assert_str_eq(log_err, "", string.concat(target, " log read"))
    spec.assert_contains(log_text, line, string.concat(target, " smoke stdout"))
}

main() {
    fw = spec.init()

    spec.describe(fw, "native Skir") {
        spec.describe("schema DSL") {
            spec.it("emits schema IR without a skir intermediate") callback {
                out_path = "/tmp/skir_aeocha_schema.json"
                document(out_path) {
                    structure(record_name("Point")) {
                        field(field_name("x"), float32_type())
                        field(field_name("y"), float32_type())
                    }

                    enumeration("RobotAction") {
                        variant("wave")
                        field(field_name("say"), string_type())
                        field(field_name("move"), ref_type(record_name("Point")))
                    }

                    constant("GREET_ACTIONS",
                             array_type(ref_type(record_name("RobotAction"))),
                             "[\"wave\"]")
                    method(method_name("PerformAction"), record_name("RobotAction"),
                           record_name("bool"), method_number(12345))
                }

                text, err = fs.read(out_path)
                spec.assert_str_eq(err, "", "schema IR read")
                spec.assert_contains(text, "\"implementation\":\"aether-dsl\"",
                                       "IR marks DSL implementation")
                spec.assert_contains(text, "\"kind\":\"struct\"", "has struct")
                spec.assert_contains(text, "\"kind\":\"enum\"", "has enum")
                spec.assert_contains(text, "\"name\":\"PerformAction\"",
                                       "has method")
            }

            spec.it("exposes compiler-derived effects for audit") callback {
                schema_effects, schema_code, schema_err =
                    run_aetherc_effects("fixtures/greet/schema.ae",
                                        "/tmp/skir_schema_effects_unused.c")
                testing.expect_no_spawn_error( schema_err,
                                             "schema effects audit started")
                testing.expect_exit( schema_code, 0,
                                   "schema effects audit exits zero")
                spec.assert_contains(schema_effects,
                                       "\"skir_schema_field\": { \"pure\": true",
                                       "schema field builder is pure")
                spec.assert_contains(schema_effects,
                                       "\"skir_schema_document\": { \"pure\": false",
                                       "schema document is effectful")
                spec.assert_contains(schema_effects,
                                       "\"reaches\": [\"fs\"]",
                                       "schema document reaches fs only")

                generator_effects, generator_code, generator_err =
                    run_aetherc_effects("generators/skir_bindgen.ae",
                                        "/tmp/skir_bindgen_effects_unused.c")
                testing.expect_no_spawn_error( generator_err,
                                             "generator effects audit started")
                testing.expect_exit( generator_code, 0,
                                   "generator effects audit exits zero")
                spec.assert_contains(generator_effects,
                                       "\"render_generic_module\": { \"pure\": true",
                                       "generic renderer is pure")
                spec.assert_contains(generator_effects,
                                       "\"write_generic_outputs\": { \"pure\": false",
                                       "generic writer is effectful")
                spec.assert_contains(generator_effects,
                                       "\"reaches\": [\"fs\"]",
                                       "generator writer reaches fs only")
            }
        }

        spec.describe("CLI") {
            spec.it("prints native version") callback {
                out, code, err = run_capture1("${os.getcwd()}/bin/skir", "version")
                testing.expect_no_spawn_error( err, "skir started")
                testing.expect_exit( code, 0, "version exits zero")
                testing.expect_stdout_contains( out, "v2.0.0-aether.0",
                                              "version is native")
            }

            spec.it("initializes and generates IR") callback {
                root = "/tmp/skir_aeocha_project_all_generators_typed_schema"
                mkdir_err = fs.mkdir_p(root)
                spec.assert_str_eq(mkdir_err, "", "temp root created")
                out_init, code_init, err_init = run_capture2("${os.getcwd()}/bin/skir", "init", "--root=${root}")
                testing.expect_no_spawn_error( err_init, "init started")
                testing.expect_exit( code_init, 0, "init exits zero")
                testing.expect_stdout_contains( out_init, "skir.json", "init names config")

                expect_aeb_target(fw, "generators/typescript/.build.ae")
                expect_aeb_target(fw, "generators/python/.build.ae")
                expect_aeb_target(fw, "generators/cpp/.build.ae")
                expect_aeb_target(fw, "generators/java/.build.ae")
                expect_aeb_target(fw, "generators/csharp/.build.ae")
                expect_aeb_target(fw, "generators/kotlin/.build.ae")
                expect_aeb_target(fw, "generators/rust/.build.ae")
                expect_aeb_target(fw, "generators/go/.build.ae")
                expect_aeb_target(fw, "generators/dart/.build.ae")
                expect_aeb_target(fw, "generators/swift/.build.ae")
                expect_aeb_target(fw, "generators/gleam/.build.ae")
                expect_aeb_target(fw, "generators/zig/.build.ae")
                expect_aeb_target(fw, "generators/moonbit/.build.ae")

                config_path = "${root}/skir.json"
                config = "{\n  \"generators\": [\n    { \"kind\": \"ir\", \"outDir\": \"./skirout\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/typescript\", \"command\": \"${os.getcwd()}/target/build/generators/typescript/bin/skir-typescript-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/python\", \"command\": \"${os.getcwd()}/target/build/generators/python/bin/skir-python-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/cpp\", \"command\": \"${os.getcwd()}/target/build/generators/cpp/bin/skir-cpp-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/java\", \"command\": \"${os.getcwd()}/target/build/generators/java/bin/skir-java-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/csharp\", \"command\": \"${os.getcwd()}/target/build/generators/csharp/bin/skir-csharp-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/kotlin\", \"command\": \"${os.getcwd()}/target/build/generators/kotlin/bin/skir-kotlin-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/rust\", \"command\": \"${os.getcwd()}/target/build/generators/rust/bin/skir-rust-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/go\", \"command\": \"${os.getcwd()}/target/build/generators/go/bin/skir-go-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/dart\", \"command\": \"${os.getcwd()}/target/build/generators/dart/bin/skir-dart-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/swift\", \"command\": \"${os.getcwd()}/target/build/generators/swift/bin/skir-swift-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/gleam\", \"command\": \"${os.getcwd()}/target/build/generators/gleam/bin/skir-gleam-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/zig\", \"command\": \"${os.getcwd()}/target/build/generators/zig/bin/skir-zig-gen\" },\n    { \"kind\": \"external\", \"outDir\": \"./bindings/moonbit\", \"command\": \"${os.getcwd()}/target/build/generators/moonbit/bin/skir-moonbit-gen\" }\n  ],\n  \"dependencies\": {}\n}\n"
                write_err = fs.write(config_path, config)
                spec.assert_str_eq(write_err, "", "generator config written")

                out_gen, code_gen, err_gen = run_capture2("${os.getcwd()}/bin/skir", "gen", "--root=${root}")
                testing.expect_no_spawn_error( err_gen, "gen started")
                testing.expect_exit( code_gen, 0, "gen exits zero")
                testing.expect_stdout_contains( out_gen, "skir-ir.json", "gen names IR")

                ir_path = "${root}/skirout/skir-ir.json"
                ir, read_err = fs.read(ir_path)
                spec.assert_str_eq(read_err, "", "IR file read")
                spec.assert_contains(ir, "\"implementation\":\"aether-dsl\"",
                                       "IR marks Aether DSL implementation")
                spec.assert_contains(ir, "\"name\":\"Greeting\"",
                                       "IR includes initialized declaration")

                bindings_ts_root = "${root}/bindings/typescript/index.ts"
                bindings_ts_mod = "${root}/bindings/typescript/schema.ts"
                bindings_py_root = "${root}/bindings/python/skir/__init__.py"
                bindings_py_mod = "${root}/bindings/python/skir/schema.py"
                spec.assert_true(fs.exists(bindings_ts_root), "ts root generated")
                spec.assert_true(fs.exists(bindings_ts_mod), "ts module generated")
                spec.assert_true(fs.exists(bindings_py_root), "python root generated")
                spec.assert_true(fs.exists(bindings_py_mod), "python module generated")
                ts_text, ts_err = fs.read(bindings_ts_mod)
                spec.assert_str_eq(ts_err, "", "TS output read")
                spec.assert_contains(ts_text, "export interface Greeting", "ts interface")
                py_text, py_err = fs.read(bindings_py_mod)
                spec.assert_str_eq(py_err, "", "Python output read")
                spec.assert_contains(py_text, "class Greeting", "python dataclass")

                cpp_text, cpp_err = fs.read("${root}/bindings/cpp/schema.hpp")
                spec.assert_str_eq(cpp_err, "", "C++ output read")
                spec.assert_contains(cpp_text, "struct Greeting", "cpp struct")
                java_text, java_err = fs.read("${root}/bindings/java/schema.java")
                spec.assert_str_eq(java_err, "", "Java output read")
                spec.assert_contains(java_text, "record Greeting", "java record")
                csharp_text, csharp_err = fs.read("${root}/bindings/csharp/schema.cs")
                spec.assert_str_eq(csharp_err, "", "C# output read")
                spec.assert_contains(csharp_text, "record Greeting", "csharp record")
                kotlin_text, kotlin_err = fs.read("${root}/bindings/kotlin/schema.kt")
                spec.assert_str_eq(kotlin_err, "", "Kotlin output read")
                spec.assert_contains(kotlin_text, "data class Greeting", "kotlin data class")
                rust_text, rust_err = fs.read("${root}/bindings/rust/schema.rs")
                spec.assert_str_eq(rust_err, "", "Rust output read")
                spec.assert_contains(rust_text, "pub struct Greeting", "rust struct")
                go_text, go_err = fs.read("${root}/bindings/go/schema.go")
                spec.assert_str_eq(go_err, "", "Go output read")
                spec.assert_contains(go_text, "type Greeting struct", "go struct")
                dart_text, dart_err = fs.read("${root}/bindings/dart/schema.dart")
                spec.assert_str_eq(dart_err, "", "Dart output read")
                spec.assert_contains(dart_text, "class Greeting", "dart class")
                swift_text, swift_err = fs.read("${root}/bindings/swift/schema.swift")
                spec.assert_str_eq(swift_err, "", "Swift output read")
                spec.assert_contains(swift_text, "struct Greeting", "swift struct")
                gleam_text, gleam_err = fs.read("${root}/bindings/gleam/schema.gleam")
                spec.assert_str_eq(gleam_err, "", "Gleam output read")
                spec.assert_contains(gleam_text, "pub type Greeting", "gleam type")
                zig_text, zig_err = fs.read("${root}/bindings/zig/schema.zig")
                spec.assert_str_eq(zig_err, "", "Zig output read")
                spec.assert_contains(zig_text, "pub const Greeting", "zig struct")
                moonbit_text, moonbit_err = fs.read("${root}/bindings/moonbit/schema.mbt")
                spec.assert_str_eq(moonbit_err, "", "MoonBit output read")
                spec.assert_contains(moonbit_text, "struct Greeting", "moonbit struct")
            }

            spec.it("builds generated binding smoke leaves with stdout checks") callback {
                expect_binding_smoke(fw, "bindings/typescript/.build.ae",
                                     "bindings_typescript.log",
                                     "typescript Greeting.message=Hello")
                expect_binding_smoke(fw, "bindings/python/.build.ae",
                                     "bindings_python.log",
                                     "python Greeting.message=Hello")
                expect_binding_smoke(fw, "bindings/cpp/.build.ae",
                                     "bindings_cpp.log",
                                     "cpp Greeting.message=Hello")
                expect_binding_smoke(fw, "bindings/java/.build.ae",
                                     "bindings_java.log",
                                     "java Greeting.message=Hello")
                expect_binding_smoke(fw, "bindings/rust/.build.ae",
                                     "bindings_rust.log",
                                     "rust Greeting.message=Hello")
                expect_binding_smoke(fw, "bindings/go/.build.ae",
                                     "bindings_go.log",
                                     "go Greeting.message=Hello")
            }
        }
    }

    return spec.run_summary(fw)
}
