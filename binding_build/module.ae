import bldr
import std.fs
import std.os
import std.path
import std.string

prepare_project(ctx: ptr, lang: string) -> string {
    root = bldr.root(ctx)
    target = bldr.target_dir(ctx)
    project = path.join(target, "project")
    _clean = os.system("rm -rf '${project}'")
    mkdir_err = fs.mkdir_p(project)
    if mkdir_err != "" {
        bldr.fail(ctx, string.concat("cannot create generated project: ", project))
        return ""
    }

    ir_path = path.join(target, "skir-ir.json")
    fixture_src = path.join(root, "fixtures/greet/schema.ae")
    fixture_bin = path.join(target, "schema-fixture")
    build_cmd = "ae build '${fixture_src}' --lib '${root}' -o '${fixture_bin}'"
    build_rc = os.system(build_cmd)
    if build_rc != 0 {
        bldr.fail(ctx, "fixture schema build failed")
        return ""
    }
    fixture_rc = os.system("'${fixture_bin}' '${ir_path}'")
    if fixture_rc != 0 {
        bldr.fail(ctx, "fixture schema run failed")
        return ""
    }

    bin_name = "skir-"
    bin_name = string.concat(bin_name, lang)
    bin_name = string.concat(bin_name, "-gen")
    gen_dir = path.join(path.join(path.join(root, "target/build/generators"), lang), "bin")
    gen = path.join(gen_dir, bin_name)
    cmd = "'${gen}' '${ir_path}' '${project}' '${lang}'"
    rc = os.system(cmd)
    if rc != 0 {
        bldr.fail(ctx, string.concat("generator failed for ", lang))
        return ""
    }
    return project
}

write_text(ctx: ptr, path_str: string, body: string) -> int {
    parent = path.dirname(path_str)
    mkdir_err = fs.mkdir_p(parent)
    if mkdir_err != "" {
        bldr.fail(ctx, string.concat("cannot create directory: ", parent))
        return 1
    }
    write_err = fs.write(path_str, body)
    if write_err != "" {
        bldr.fail(ctx, string.concat("cannot write file: ", path_str))
        return 1
    }
    return 0
}
