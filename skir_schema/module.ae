import std.fs
import std.list
import std.string

exports (
    document, structure, enumeration, field, variant, constant, method,
    string_type, int32_type, bool_type, float32_type, array_type, optional_type,
    keyed_array_type, ref_type
)

json_escape(s: string) -> string {
    out = ""
    i = 0
    n = string.length(s)
    while i < n {
        ch = string.char_at(s, i)
        if ch == 34 {
            out = string.concat(out, "\\\"")
        } else if ch == 92 {
            out = string.concat(out, "\\\\")
        } else if ch == 10 {
            out = string.concat(out, "\\n")
        } else if ch == 13 {
            out = string.concat(out, "\\r")
        } else if ch == 9 {
            out = string.concat(out, "\\t")
        } else {
            out = string.concat(out, string.from_char(ch))
        }
        i = i + 1
    }
    return out
}

quote(s: string) -> string {
    out = "\""
    out = string.concat(out, json_escape(s))
    out = string.concat(out, "\"")
    return out
}

require_non_empty(value: string where string.length(value) > 0) -> string {
    return value
}

require_positive(value: int where value > 0) -> int {
    return value
}

append_json(ctx: ptr, text: string) {
    if ctx != null {
        list.add(ctx, text)
    }
}

render_array(items: ptr) -> string {
    out = "["
    if items != null {
        n = list.size(items)
        i = 0
        while i < n {
            item, _ = list.get(items, i)
            if i > 0 {
                out = string.concat(out, ",")
            }
            out = string.concat(out, item)
            i = i + 1
        }
    }
    out = string.concat(out, "]")
    return out
}

string_type() -> string { return "{\"kind\":\"primitive\",\"name\":\"string\"}" }
int32_type() -> string { return "{\"kind\":\"primitive\",\"name\":\"int32\"}" }
bool_type() -> string { return "{\"kind\":\"primitive\",\"name\":\"bool\"}" }
float32_type() -> string { return "{\"kind\":\"primitive\",\"name\":\"float32\"}" }

array_type(element: string where string.length(element) > 0) -> string {
    out = "{\"kind\":\"array\",\"element\":"
    out = string.concat(out, element)
    out = string.concat(out, "}")
    return out
}

optional_type(inner: string where string.length(inner) > 0) -> string {
    out = "{\"kind\":\"optional\",\"inner\":"
    out = string.concat(out, inner)
    out = string.concat(out, "}")
    return out
}

keyed_array_type(element: string where string.length(element) > 0,
                 key: string where string.length(key) > 0) -> string {
    out = "{\"kind\":\"keyed_array\",\"element\":"
    out = string.concat(out, element)
    out = string.concat(out, ",\"key\":")
    out = string.concat(out, quote(key))
    out = string.concat(out, "}")
    return out
}

ref_type(name: string where string.length(name) > 0) -> string {
    out = "{\"kind\":\"ref\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, "}")
    return out
}

field(_ctx: ptr, name: string, type_json: string) {
    name = require_non_empty(name)
    type_json = require_non_empty(type_json)
    out = "{\"kind\":\"field\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, ",\"type\":")
    out = string.concat(out, type_json)
    out = string.concat(out, "}")
    append_json(_ctx, out)
}

variant(_ctx: ptr, name: string) {
    name = require_non_empty(name)
    out = "{\"kind\":\"variant\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, "}")
    append_json(_ctx, out)
}

builder structure(name: string where string.length(name) > 0) with list_new {
    parent = builder_context()
    out = "{\"kind\":\"struct\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, ",\"fields\":")
    out = string.concat(out, render_array(_builder))
    out = string.concat(out, "}")
    append_json(parent, out)
}

builder enumeration(name: string where string.length(name) > 0) with list_new {
    parent = builder_context()
    out = "{\"kind\":\"enum\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, ",\"members\":")
    out = string.concat(out, render_array(_builder))
    out = string.concat(out, "}")
    append_json(parent, out)
}

constant(_ctx: ptr, name: string, type_json: string, value_json: string) {
    name = require_non_empty(name)
    type_json = require_non_empty(type_json)
    value_json = require_non_empty(value_json)
    out = "{\"kind\":\"constant\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, ",\"type\":")
    out = string.concat(out, type_json)
    out = string.concat(out, ",\"value\":")
    out = string.concat(out, value_json)
    out = string.concat(out, "}")
    append_json(_ctx, out)
}

method(_ctx: ptr, name: string, request_type: string, response_type: string,
       number: int) {
    name = require_non_empty(name)
    request_type = require_non_empty(request_type)
    response_type = require_non_empty(response_type)
    number = require_positive(number)
    out = "{\"kind\":\"method\",\"name\":"
    out = string.concat(out, quote(name))
    out = string.concat(out, ",\"request\":")
    out = string.concat(out, ref_type(request_type))
    out = string.concat(out, ",\"response\":")
    out = string.concat(out, ref_type(response_type))
    out = string.concat(out, ",\"number\":")
    out = string.concat(out, string.from_int(number))
    out = string.concat(out, "}")
    append_json(_ctx, out)
}

builder document(path: string where string.length(path) > 0) with list_new {
    out = "{\"schemaVersion\":1,\"implementation\":\"aether-dsl\",\"modules\":[{\"path\":\"schema.ae\",\"declarations\":"
    out = string.concat(out, render_array(_builder))
    out = string.concat(out, "}]}")
    err = fs.write(path, out)
    if err != "" {
        println(string.concat("skir schema IR write failed: ", path))
        exit(1)
    }
}
